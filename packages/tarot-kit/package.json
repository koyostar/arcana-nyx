{
  "name": "@cometpisces/tarot-kit",
  "version": "0.3.0",
  "description": "Complete Rider-Waite tarot deck data with card meanings, drawing utilities, and localization - TypeScript library for building tarot reading apps",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "export:json": "node dist/scripts/export-json.js",
    "test": "echo \"no tests yet\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2"
  },
  "keywords": [
    "tarot",
    "rider-waite",
    "tarot-cards",
    "card-meanings",
    "divination",
    "major-arcana",
    "minor-arcana",
    "card-reading",
    "typescript",
    "localization",
    "i18n"
  ]
}
